{"nodes": [{"id": "jax_sim_main_jax_jax_simulation_loop", "label": "JAX Simulation Loop (Init\u2192Rollout\u2192PPO\u2192Repeat)", "file_type": "concept", "source_file": "jax_sim/main_jax.py", "source_location": "1:13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-phase training loop: init grid/populations/network; lax.scan rollout of observe\u2192forward\u2192act\u2192env-step; GAE+PPO gradient update outside scan; repeat for n_updates."}, {"id": "jax_sim_main_jax_lax_scan_rollout", "label": "lax.scan JIT Rollout Kernel", "file_type": "concept", "source_file": "jax_sim/main_jax.py", "source_location": "177:422", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each sim_step inside scan is @jit-compiled; entire T-step rollout becomes one XLA kernel. Params passed through carry with stop_gradient during rollout."}, {"id": "jax_sim_main_jax_rollout_to_cpu", "label": "Rollout-to-CPU VRAM Strategy", "file_type": "rationale", "source_file": "jax_sim/main_jax.py", "source_location": "123:130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full T\u00d7N rollout (~2.4GB obs alone) moved off GPU before PPO backward; XLA_PYTHON_CLIENT_MEM_FRACTION=0.80 leaves headroom."}, {"id": "jax_sim_main_jax_dual_team_training", "label": "Dual-Team Blue/Red PPO Training", "file_type": "concept", "source_file": "jax_sim/main_jax.py", "source_location": "393:417", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate b_params/r_params, optimizers, and rollout batches; blue limited red sensing; red curriculum floor applied outside JIT."}, {"id": "jax_sim_main_jax_red_curriculum", "label": "Red Population Curriculum", "file_type": "concept", "source_file": "jax_sim/main_jax.py", "source_location": "628:932", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Red floo